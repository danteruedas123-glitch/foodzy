rules_version = '2';

// Reglas de seguridad de Foodzy.
// Copia este contenido en: Firebase Console → Firestore Database → Reglas → Publicar.
// Antes de publicar, corre las pruebas: cd firestore-tests && npm test
service cloud.firestore {
  match /databases/{database}/documents {

    function rutaHogar(hogarId) {
      return /databases/$(database)/documents/hogares/$(hogarId);
    }

    // ¿La persona con sesión iniciada pertenece a este hogar?
    function esMiembro(hogarId) {
      return request.auth != null &&
        request.auth.uid in get(rutaHogar(hogarId)).data.miembros;
    }

    // Campo de texto con un largo máximo (o ausente / nulo).
    function textoCorto(datos, campo, maximo) {
      return !(campo in datos) || datos[campo] == null
        || (datos[campo] is string && datos[campo].size() <= maximo);
    }

    // Datos de cada usuario: solo él los lee y escribe, y solo estos campos.
    // `codigoUsado` es el código con el que entró a un hogar (lo pide la regla
    // de unirse).
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hogarId', 'nombre', 'email', 'codigoUsado'])
        && textoCorto(request.resource.data, 'hogarId', 100)
        && textoCorto(request.resource.data, 'nombre', 200)
        && textoCorto(request.resource.data, 'email', 320)
        && textoCorto(request.resource.data, 'codigoUsado', 20);
    }

    // Códigos de invitación: se pueden consultar uno a uno (get), nunca listar.
    match /invitaciones/{codigo} {
      allow get: if request.auth != null;

      // Solo el dueño de un hogar crea su código, y tiene que ser el código
      // que el hogar queda teniendo (al crear el hogar o al cambiar el código,
      // en la misma escritura en lote).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['hogarId'])
        && getAfter(rutaHogar(request.resource.data.hogarId)).data.creadoPor == request.auth.uid
        && getAfter(rutaHogar(request.resource.data.hogarId)).data.codigo == codigo;

      // El dueño borra el código viejo al cambiarlo.
      allow delete: if request.auth != null
        && (resource == null
          || get(rutaHogar(resource.data.hogarId)).data.creadoPor == request.auth.uid);
    }

    // Un hogar: lo ven sus miembros.
    //
    // Quién puede cambiarlo:
    //   - Una persona puede unirse a un hogar que tenga gente, añadiéndose a sí
    //     misma, solo con el código VIGENTE del hogar.
    //   - Cualquier miembro puede salir, quitándose a sí mismo.
    //   - Solo el dueño (quien creó el hogar) puede quitar a otra persona o
    //     cambiar el código. Al cambiarlo, el código viejo deja de servir.
    match /hogares/{hogarId} {
      function antes() { return resource.data.miembros; }
      function despues() { return request.resource.data.miembros; }
      function yo() { return request.auth.uid; }

      // Entra una persona más: se añade ella misma, a un hogar que no esté
      // vacío, y en la misma escritura deja en su perfil el código con el que
      // entra, que debe ser el vigente. Quien conoce el id del hogar o un
      // código viejo ya no puede entrar.
      function seUne() {
        return antes().size() > 0
          && !(yo() in antes())
          && yo() in despues()
          && despues().size() == antes().size() + 1
          && despues().hasAll(antes())
          && getAfter(/databases/$(database)/documents/usuarios/$(yo())).data.get('codigoUsado', '') == resource.data.codigo;
      }

      // Sale una persona: se quita ella misma y nadie más cambia.
      function sale() {
        return yo() in antes()
          && !(yo() in despues())
          && despues().size() == antes().size() - 1
          && antes().hasAll(despues());
      }

      // El dueño quita a otra persona; él sigue dentro.
      function duenoQuitaAOtro() {
        return resource.data.creadoPor == yo()
          && yo() in antes()
          && yo() in despues()
          && despues().size() == antes().size() - 1
          && antes().hasAll(despues());
      }

      // El dueño cambia el código; el nuevo se crea en la misma escritura.
      function duenoCambiaCodigo() {
        return resource.data.creadoPor == yo()
          && yo() in antes()
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() >= 6
          && request.resource.data.codigo.size() <= 12
          && getAfter(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigo)).data.hogarId == hogarId;
      }

      // Se crea un hogar para uno mismo, y uno queda como su dueño.
      allow create: if request.auth != null
        && request.resource.data.miembros == [request.auth.uid]
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() <= 12;

      allow read: if request.auth != null && request.auth.uid in resource.data.miembros;

      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
          && (seUne() || sale() || duenoQuitaAOtro()))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codigo'])
          && duenoCambiaCodigo())
      );

      // La despensa y la lista de compras: solo los miembros del hogar, y con
      // límites de tamaño para que nadie llene el hogar de datos basura que
      // todos los demás tengan que descargar.
      function alimentoValido(d) {
        return d.keys().size() <= 30
          && d.nombre is string && d.nombre.size() <= 200
          && textoCorto(d, 'categoria', 100)
          && (!('fotos' in d) || (d.fotos is list && d.fotos.size() <= 20));
      }

      function renglonValido(d) {
        return d.keys().hasOnly(['id', 'nombre', 'cantidad', 'comprado', 'creado'])
          && d.nombre is string && d.nombre.size() <= 200
          && textoCorto(d, 'cantidad', 100);
      }

      match /alimentos/{id} {
        allow read, delete: if esMiembro(hogarId);
        allow create, update: if esMiembro(hogarId) && alimentoValido(request.resource.data);
      }
      match /lista/{id} {
        allow read, delete: if esMiembro(hogarId);
        allow create, update: if esMiembro(hogarId) && renglonValido(request.resource.data);
      }
    }
  }
}

rules_version = '2';

// Reglas de seguridad de Foodzy.
// Copia este contenido en: Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿La persona con sesión iniciada pertenece a este hogar?
    function esMiembro(hogarId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
    }

    // Datos de cada usuario: solo él los lee y escribe.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Códigos de invitación: se pueden consultar uno a uno (get), nunca listar.
    match /invitaciones/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Un hogar: lo ven sus miembros.
    //
    // Quién puede cambiarlo (solo la lista de miembros; el código y el dueño
    // no se modifican nunca):
    //   - Cualquier persona puede unirse a un hogar que tenga gente, añadiéndose
    //     a sí misma (conociendo el id que obtuvo con el código).
    //   - Cualquier miembro puede salir, quitándose a sí mismo.
    //   - Solo el dueño (quien creó el hogar) puede quitar a otra persona.
    match /hogares/{hogarId} {
      function antes() { return resource.data.miembros; }
      function despues() { return request.resource.data.miembros; }
      function yo() { return request.auth.uid; }

      // Entra una persona más: se añade ella misma, a un hogar que no esté vacío.
      function seUne() {
        return antes().size() > 0
          && !(yo() in antes())
          && yo() in despues()
          && despues().size() == antes().size() + 1
          && despues().hasAll(antes());
      }

      // Sale una persona: se quita ella misma y nadie más cambia.
      function sale() {
        return yo() in antes()
          && !(yo() in despues())
          && despues().size() == antes().size() - 1
          && antes().hasAll(despues());
      }

      // El dueño quita a otra persona; él sigue dentro.
      function duenoQuitaAOtro() {
        return resource.data.creadoPor == yo()
          && yo() in antes()
          && yo() in despues()
          && despues().size() == antes().size() - 1
          && antes().hasAll(despues());
      }

      // Se crea un hogar para uno mismo, y uno queda como su dueño.
      allow create: if request.auth != null
        && request.resource.data.miembros == [request.auth.uid]
        && request.resource.data.creadoPor == request.auth.uid;

      allow read: if request.auth != null && request.auth.uid in resource.data.miembros;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
        && (seUne() || sale() || duenoQuitaAOtro());

      // La despensa y la lista de compras: solo los miembros del hogar.
      match /alimentos/{id} {
        allow read, write: if esMiembro(hogarId);
      }
      match /lista/{id} {
        allow read, write: if esMiembro(hogarId);
      }
    }
  }
}

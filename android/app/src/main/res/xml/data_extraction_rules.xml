<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: los datos de la app (preferencias, base SQLite, almacenamiento
     cifrado) no van a la copia en la nube ni se pasan a otro teléfono.
     La despensa compartida se recupera desde Firebase al iniciar sesión.
     Hallazgo de seguridad H-06. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
